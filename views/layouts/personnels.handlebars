<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/personnels/global.css" />
    <link rel="icon" type="image/png" href="/assets/mc-bat.png" />
    <script type="module" src="/js/personnels/global.js" defer></script>

    {{#each styles}}
        <link rel="stylesheet" href="/css/{{ this }}">
    {{/each}}
    {{#each scripts }}
        <script type="module" src="/js/{{ this }}" defer></script>
    {{/each}}
    <script type="module" src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.js"></script>
    <title>{{title}}</title>
  </head>
  <body>
    <div class="personnel-container-header-main">
        {{> personnels/header}}
        <main>
            {{{body}}}
            {{> personnels/footer }}
        </main>
    </div>

    
  </body>
</html>