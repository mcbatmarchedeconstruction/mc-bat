<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/js/global.js" defer></script>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="icon" type="image/png" href="/assets/mc-bat.png">

    <!-- SEO -->
    <meta name="description"
          content="MC-BAT - Marché de construction et de bâtiment. Découvrez nos services, offres, réalisations et demandez votre devis.">

    <!-- Open Graph : aperçu lors du partage -->
    <meta property="og:title"
          content="{{title}}">

    <meta property="og:description"
          content="MC-BAT - {{description}}">

    <meta property="og:image"
          content="https://mc-bat.onrender.com/assets/{{image}}">

    <meta property="og:url"
          content="https://mc-bat.onrender.com{{url}}">

    <meta property="og:type"
          content="website">

    <meta property="og:site_name"
          content="MC-BAT">

    <meta property="og:locale"
          content="fr_FR">

    {{#each styles}}
        <link rel="stylesheet" href="/css/{{ this }}">
    {{/each}}
    {{#each scripts }}
        <script type="module" src="/js/{{ this }}" defer></script>
    {{/each}}
    <script type="module" src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.js"></script>
    <title>{{ title }}</title>
</head>
<body>
    {{> visiteurs/header}}
    {{> visiteurs/popup}}
    {{#unless (eq currentPage '/')}}  
        {{> visiteurs/background}}
    {{/unless}}
    <main>
        {{{ body }}}
    </main>
    {{> visiteurs/footer}}
</body>
</html>