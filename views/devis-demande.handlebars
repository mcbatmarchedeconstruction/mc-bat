<section>
   <div class="title-form-devis">
     <h2>DEMANDEZ VOTRE DEVIS GRATUIT</h2>
    <P>Remplissez le formulaire ci-dessous et nous vous répondrons dans les plus brefs délais.</P>
   </div>

    <div class="form-add-edite">
            
            <form class="form">
                <div class="champ">
                    <label for="nom ">Nom complet <i>*</i></label>
                    <input type="text" placeholder="Jean Philippe" name="nom_complet">
                </div>
                <div class="champ">
                    <label for="email">Email <i>*</i></label>
                    <input type="text" placeholder="Jean@gmail.com" name="email">
                </div>
                <div class="champ">
                    <label for="telephone">Téléphone <i>*</i></label>
                    <input type="text" placeholder="243-456-987-876" name="telephone">
                </div>
                <div class="champ">
                    <label for="contenu">Détails du projet <i>*</i></label>
                       <textarea name="details_projet" rows="5" placeholder="Décrivez le projet"></textarea>
                </div>
                <div class="champ">
                    <label for="secteur">Secteur <i>*</i></label>
                    <select name="secteur">
                        <option value="Résidentiel">Résidentiel</option>
                        <option value="Commercial">Commercial</option>
                        <option value="Industriel">Industriel</option>
                        <option value="Institutionnel">Institutionnel</option>

                        <option value="Génie civil">Génie civil</option>
                        <option value="Travaux publics">Travaux publics</option>
                        <option value="Rénovation">Rénovation</option>
                        <option value="Aménagement extérieur">Aménagement extérieur</option>
                    </select>

                </div>
                <div class="champ">
                    <label for="budget">Budget <i>*</i></label>
                    <input type="text" placeholder="ex : 1.000" name="budget">
                </div>

                <div class="btn-add-edtite">
                     <button type="submit" id="btn-add">
                        <ion-icon name="send-outline"></ion-icon>
                        <span>Envoyer</span>
                    </button>
               </div>
               <span class="message"></span>
            </form>
        </div>
</section>
