<section class="form-connexion">
    

    <div class="container-form">
        <h1>Connexion</h1>
        <form class="form">
            <div class="input">
                <label for="email">Email <i>*</i></label>
                <input type="email" placeholder="exemple@gmail.com" name="email">
            </div>
            <div class="input">
                <label for="password">Mot de passe <i>*</i></label>
                <input type="password" placeholder="Entrez votre mot de passe" name="mot_de_passe">
            </div>
            <button type="submit">Se connecter</button>
            <div class="status">
                <ion-icon class="loader" name="reload-outline"></ion-icon>
                <span></span>
            </div>
            <span class="span"></span>
        </form>
    </div>
</section>