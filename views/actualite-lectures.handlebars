<section class="lecture">
    <img src="{{actualite.image}}" class="image-lecture" alt="Photo de la lecture"/>
    <div class="detail-lecture">
        <div class="date-secteur">
            <p class="lecture-secteur">{{actualite.secteur}}</p>
            <p>{{actualite.date}}</p>
        </div>
        <h2>{{actualite.titre}}</h2>

        <p class="lecture-contenu">
            {{actualite.contenu}}
        </p>

        <div class="lecture-retour">
            <a href="/visiteurs/actualites/liste">RETOUR AUX ACTUALITÉS</a>
        </div>
    </div>
</section>