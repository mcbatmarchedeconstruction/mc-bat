<!-- POPUP -->
<div id="popup" class="popup">
    <div class="popup-content">

        <button type="button" class="popup-close" id="popup-close">
            &times;
        </button>

        <div class="popup-icon" id="popup-icon">
            <ion-icon name="checkmark-circle-outline"></ion-icon>
        </div>

        <h2 id="popup-title">Ajout réussi !</h2>

        <p id="popup-message">
            L'élément a été ajouté avec succès.
        </p>

        <button type="button" class="popup-btn" id="popup-btn">
            OK
        </button>

    </div>
</div>