<section class="lecture">
    <img src="{{realisation.image}}" class="image-lecture" alt="Photo de la lecture"/>
    <div class="detail-lecture">
        <div class="date-secteur">
            <p class="lecture-secteur">{{realisation.secteur}}</p>
            <p>{{realisation.date}}</p>
        </div>
        <h2>{{realisation.titre}}</h2>

        <p class="lecture-contenu">
            {{realisation.description}}
        </p>

        <div class="lecture-retour">
            <a href="/visiteurs/realisations/liste">RETOUR AUX RÉALISATIONS</a>
        </div>
    </div>
</section>