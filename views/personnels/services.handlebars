<section>
    <div class="container">
        <div class="title-option-ajouter">
            <h1>{{ title }}</h1>
            <div class="btn-add">
                <button type="button" id="btn-add">
                    <ion-icon name="add-outline"></ion-icon>
                    <span>Ajouter un service</span>
                </button>
            </div>
        </div>

        <div id="form" class="form-add-edite">
           <div class="titre">
                <h2 class="ajouter">Ajouter</h2>
                <h2 class="modifier">Modifier</h2>
                <p class="message1"></p>
            </div>
            <form class="form">
                <div class="titre">
                    <label for="titre">Titre <i>*</i></label>
                    <input type="text" placeholder="Titre du service" name="titre">
                </div>
                <div class="contenu">
                    <label for="contenu">Description <i>*</i></label>
                    <textarea name="description" rows="5" placeholder="Description du service (points clés)"></textarea>
                </div>
                <div class="image">
                    <label for="image">Image <i>*</i></label>
                    <input type="file" name="image">
                </div>

               <div class="btn-add-edtite">
                    <button type="submit" id="btn-edite">
                        <ion-icon name="send-outline"></ion-icon>
                        <span>Valider</span>
                    </button>
                     <button type="submit" id="btn-add">
                        <ion-icon name="send-outline"></ion-icon>
                        <span>Créer</span>
                    </button>
               </div>
            </form>
        </div>

        <div class="tableau">
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <p class="message2">
                        {{!-- <td><img src="/assets/home.JPG" alt=""></td>
                        <td>Mon titre</td>
                        <td class="limit-description"><p>ok</p></td>
                        <td>Publié</td>
                        <td class="action">
                           <div class="btn-action">
                                <ion-icon class="edite" name="create-outline"></ion-icon>
                                <ion-icon class="delete" name="trash-outline"></ion-icon>
                            </div>
                        </td> --}}
                    </p>
                </tbody>
            </table>
        </div>
    </div>
</section>